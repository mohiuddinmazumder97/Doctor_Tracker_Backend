# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (database name is set via MONGODB_DB_NAME)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME=doctor_tracker

# Auth — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-of-at-least-32-chars
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:3000

# Demo admin created by `npm run seed`
SEED_ADMIN_EMAIL=admin@doctortracker.dev
SEED_ADMIN_PASSWORD=lskfjlsfdwre

# Optional
# Number of proxies in front of the app (Render load balancer, Vercel rewrite) — used for client IPs
TRUST_PROXY=1
# pino log level: fatal | error | warn | info | debug
LOG_LEVEL=info
